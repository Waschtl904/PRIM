[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "prim"
version = "0.1.0"
authors = [{name = "Sebastian Waschtl", email = "your.email@example.com"}]
description = "Modulares Framework für Primzahltests und -analysen"
readme = "README.md"
requires-python = ">=3.8"
dependencies = [
    "numpy>=1.21.0",
    "scipy>=1.7.0",
    "matplotlib>=3.5.0"
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "pytest-cov>=4.0.0",
    "black>=22.0.0",
    "flake8>=5.0.0"
]

[tool.setuptools]
package-dir = {"" = "src"}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = [
    "--cov=prim",
    "--cov-report=html",
    "--cov-report=term-missing"
]
python_paths = ["src"]

[tool.coverage.run]
source = ["src/prim"]
omit = ["*/tests/*", "*/__pycache__/*"]

[tool.black]
line-length = 88
target-version = ["py38", "py39", "py310", "py311"]
